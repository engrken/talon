# Project-specific Neon PostgreSQL URL (NEVER reuse CLEAR or CircuitByte database)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
# Random private administrator token, 32+ characters
ADMIN_SETUP_TOKEN=REPLACE_WITH_RANDOM_32_OR_MORE_CHARACTERS
# Optional Vercel Cron + Resend daily report
CRON_SECRET=REPLACE_WITH_RANDOM_32_OR_MORE_CHARACTERS
RESEND_API_KEY=
REPORT_FROM=
REPORT_TO=
NEXT_PUBLIC_SITE_URL=https://talon.vercel.app
